# Inkriff — plantilla de configuración
# Copia este archivo a .env y rellena al menos UNA de las dos keys.
# .env está en .gitignore: nunca subas tus keys al repositorio.

# --- LLM principal ---
OPENAI_API_KEY=
INKRIFF_LLM_MODELO_OPENAI=gpt-4o-mini

# --- LLM de respaldo (gratis: https://console.groq.com/keys) ---
GROQ_API_KEY=
INKRIFF_LLM_MODELO_GROQ=openai/gpt-oss-20b

# Proveedor primario: "openai" (default) o "groq" (solo la opción gratuita)
INKRIFF_LLM_PROVEEDOR=openai
